{
  "storage": {
    "rules": "storage.rules"
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "to2mor-76e32",
          "configurations": {
            "web": "1:951912549415:web:381920becb6b8921e25202",
            "windows": "1:951912549415:web:e31a4c77da2d84cde25202"
          }
        }
      }
    }
  },
  "hosting": [
    {
      "target": "prod",
      "public": "build/restaurant",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/.dart_tool/**",
        "**/.idea/**",
        "**/.vscode/**",
        "**/build/**/cache/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(mp3|wav|ogg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            },
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/flutter_service_worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/version.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "dev",
      "public": "build/restaurant-test",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/.dart_tool/**",
        "**/.idea/**",
        "**/.vscode/**",
        "**/build/**/cache/**"
      ],
